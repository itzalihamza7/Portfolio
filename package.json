{
  "private": false,
  "name": "Portfolio",
  "version": "1.0.0",
  "homepage": "https://www.alihamza.co/",
  "scripts": {
    "build": "react-scripts build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "eject": "react-scripts eject",
    "start": "react-scripts  start",
    "test": "react-scripts test"
  },
  "dependencies": {
    "gh-pages": "^3.1.0",
    "prettier-package-json": "^2.1.3",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "react-ga": "^3.3.0",
    "react-icons": "^4.2.0",
    "react-scripts": "^3.4.4"
  },
  "devDependencies": {
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "prettier": "2.2.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  }
}
